# Copy to .env for local development: cp .env.example .env
# .env is git-ignored. Never commit real values.
# Variables already set in the environment take precedence over .env.

# Port the server listens on. Optional, defaults to 8080. Cloud Run sets it.
PORT=8080

# Public base URL of the app: absolute http(s), no path, no trailing slash.
# Used for the Spotify redirect URL and the Origin check.
BASE_URL=http://127.0.0.1:8080

# Spotify app client ID (from the Spotify developer dashboard).
SPOTIFY_CLIENT_ID=your-spotify-client-id

# Spotify app client secret. Secret.
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# setlist.fm API key (https://www.setlist.fm/settings/api). Secret.
SETLISTFM_API_KEY=your-setlistfm-api-key

# Key for encrypting the session cookie: base64 of exactly 32 random bytes. Secret.
# Generate one with: openssl rand -base64 32
SESSION_KEY=replace-with-output-of-openssl-rand-base64-32
